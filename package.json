{
  "name": "telega-ads-app",
  "version": "2.0.0",
  "description": "Enterprise High-Performance Telegram Mini App Advertising & Monetization Architecture",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "test": "jest --passWithNoTests --detectOpenHandles",
    "clean": "rimraf node_modules"
  },
  "keywords": [
    "telegram",
    "mini-app",
    "ads-network",
    "monetization",
    "express",
    "mongoose",
    "redis",
    "serverless",
    "vercel",
    "security"
  ],
  "author": "Amin Al-Alimi",
  "license": "MIT",
  "dependencies": {
    "@telegram-apps/init-data-node": "^1.0.4",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "rate-limit-redis": "^4.2.0",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
